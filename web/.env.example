# Generate with: openssl rand -base64 48
# Optional local Windows setup: absolute secret env file OUTSIDE OneDrive/project.
# Populated automatically by db:local connect; do not copy another machine's path.
ANAFIX_LOCAL_ENV_PATH=
AUTH_SESSION_SECRET=

# Encrypts the development server-side examination store. Use an independent
# secret with at least 32 characters; changing it makes old records unreadable.
EXAMINATION_DATA_KEY=
# Optional absolute path. Defaults to .data/examinations.enc
EXAMINATION_STORE_PATH=

# Optional durable append-only log for print/copy/PDF requests. Defaults to
# .data/examination-export-audit.jsonl. Keep this path on backed-up server storage.
EXPORT_AUDIT_PATH=

# Encrypts organization and employee accounts in the development store.
IDENTITY_DATA_KEY=
# Optional absolute path. Defaults to .data/identities.enc
IDENTITY_STORE_PATH=

# Administrative metadata journal (no patient contents). Restrict filesystem access.
SECURITY_AUDIT_PATH=
# Optional report from an independently configured backup job:
# {"status":"success","completedAt":"2026-10-03T09:00:00Z"}
# Missing report is displayed as not connected; this does not enable backups.
BACKUP_STATUS_PATH=

# Offline access is allowed only on hospital computers after policy approval.
# Approved: 48 hours access, 7 days retention for synchronized local copies.
# Keep disabled until authorized hospital computers are configured and tested.
OFFLINE_ENABLED=false
OFFLINE_ACCESS_HOURS=48
# Exact public origin, e.g. https://anafix.hospital.example; no trailing slash.
# Mandatory for offline enrollment/sync in production (CSRF protection).
APP_ORIGIN=

# Production-only bootstrap admin. Store the hash in a secret manager.
PLATFORM_ADMIN_LOGIN=
# Format: scrypt$<salt>$<base64url hash>
PLATFORM_ADMIN_PASSWORD_SCRYPT=

# files = single-process prototype; postgres = shared transactional storage.
# Never switches to files automatically after a PostgreSQL error.
STORAGE_BACKEND=files
DATABASE_URL=
# disable is accepted only for localhost. Remote connections require verified TLS.
DATABASE_SSL_MODE=
DATABASE_CA_CERT=
# JSON arrays of retained encryption keys; never put actual keys into Git.
IDENTITY_DATA_PREVIOUS_KEYS=[]
EXAMINATION_DATA_PREVIOUS_KEYS=[]
# Enable only behind a proxy that replaces client-provided forwarded headers.
TRUST_PROXY_CLIENT_IP=false
# Planned payment integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
